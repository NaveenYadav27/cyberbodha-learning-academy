{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberbodha-learning-academy",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "cyberbodha.com/*",
      "zone_name": "cyberbodha.com"
    },
    {
      "pattern": "www.cyberbodha.com/*",
      "zone_name": "cyberbodha.com"
    }
  ]
}
